#!/usr/bin/env bash
# snag: collect screenshot + note pairs into one folder for a coding agent.
set -euo pipefail

user_path=$PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
config=${XDG_CONFIG_HOME:-$HOME/.config}/snag/config

# SNAG_DIR wins over `dir=` in the config file. Raycast does not pass shell env, so the file is the durable setting.
conf_dir=""
[[ -f $config ]] && conf_dir=$(sed -n 's/^dir=//p' "$config" | tail -n 1)
conf_dir=${conf_dir/#\~/$HOME}
dir=${SNAG_DIR:-${conf_dir:-$HOME/.snag}}
cur=$dir/current
items=$cur/items.jsonl
note_bin=$root/build/snag-note
hud_bin=$root/build/snag-hud

# First line of the note, max 80 characters. Shared by `ls` and issues.md.
jq_headline='def headline: (.note | split("\n")[0] // "") as $l
  | if $l == "" then "(no note)" elif ($l | length) > 80 then $l[0:79] + "…" else $l end;'

count() {
  if [[ -s $items ]]; then wc -l <"$items" | tr -d ' '; else echo 0; fi
}

frontmost_app() {
  osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true
}

# Prints "URL<newline>title" of the active tab, or nothing when the app is not a known browser.
browser_tab() {
  local tab
  case $1 in
    "Google Chrome" | "Arc" | "Brave Browser" | "Microsoft Edge") tab="active tab of front window" ;;
    "Safari") tab="current tab of front window" ;;
    *) return 0 ;;
  esac
  osascript -e "tell application \"$1\" to get (URL of $tab) & linefeed & (name of $tab)" 2>/dev/null || true
}

# Compiles src/<name>.swift to build/snag-<name> when the source is newer.
build() {
  local src=$root/src/$1.swift bin=$root/build/snag-$1
  [[ $bin -nt $src ]] && return 0
  mkdir -p "$root/build"
  swiftc -O "$src" -o "$bin" >&2 || { echo "Build of snag-$1 failed"; return 1; }
}

# One HUD per stack. It exits by itself when the stack is empty or finished.
start_hud() {
  [[ -z ${SNAG_NO_HUD:-} ]] || return 0
  pgrep -qf "$hud_bin $items" && return 0
  build hud || return 0
  # New session, so Raycast ending the script's process group cannot take the pill with it.
  /usr/bin/perl -MPOSIX -e 'fork and exit; POSIX::setsid(); exec @ARGV' \
    "$hud_bin" "$items" </dev/null >/dev/null 2>&1
}

cmd_add() {
  local app tab url="" title="" tmp png note n img at
  app=$(frontmost_app)
  tab=$(browser_tab "$app")
  if [[ -n $tab ]]; then
    url=${tab%%$'\n'*}
    title=${tab#*$'\n'}
  fi

  tmp=$(mktemp -d)
  trap "rm -rf '$tmp'" EXIT
  png=$tmp/shot.png
  if [[ -n ${SNAG_IMAGE:-} ]]; then
    cp "$SNAG_IMAGE" "$png"
  else
    screencapture -i -x "$png" || true
  fi
  [[ -s $png ]] || { echo "Cancelled"; return 0; }

  if [[ -n ${SNAG_NOTE+set} ]]; then
    note=$SNAG_NOTE
  else
    build note || exit 1
    note=$("$note_bin" "$png") || { echo "Discarded"; return 0; }
  fi

  mkdir -p "$cur"
  n=$(($(count) + 1))
  img=$(printf '%02d.png' "$n")
  at=$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})$/:\1/')
  mv "$png" "$cur/$img"
  jq -nc --argjson n "$n" --arg image "$img" --arg note "$note" \
    --arg app "$app" --arg url "$url" --arg title "$title" --arg at "$at" '
    def nullable: if . == "" then null else . end;
    {n: $n, image: $image, note: $note, app: ($app | nullable),
     url: ($url | nullable), title: ($title | nullable), at: $at}' >>"$items"
  start_hud
  echo "Snag #$n added"
}

cmd_undo() {
  [[ $(count) -gt 0 ]] || { echo "No snags"; return 0; }
  local last
  last=$(tail -n 1 "$items")
  sed -i '' '$d' "$items"
  rm -f "$cur/$(jq -r .image <<<"$last")"
  echo "Removed #$(jq -r .n <<<"$last")"
}

cmd_ls() {
  local c
  c=$(count)
  echo "$c snag$([[ $c == 1 ]] || echo s)"
  [[ $c -gt 0 ]] || return 0
  jq -r "$jq_headline"' "\(.n). \(headline)"' "$items"
}

render() {
  jq -rs --arg when "$(date '+%Y-%m-%d %H:%M')" "$jq_headline"'
    "# Snag \($when)\n\n\(length) issue\(if length == 1 then "" else "s" end). Screenshots sit next to this file.\n",
    (.[] |
      "## \(.n). \(headline)\n",
      "- App: \(.app // "unknown")",
      (select(.url) | "- URL: \(.url)\(if .title then " (\"\(.title)\")" else "" end)"),
      "- At: \(.at[11:19])\n",
      (select(.note != "") | "\(.note)\n"),
      "![\(.image | rtrimstr(".png"))](\(.image))\n")' "$items"
}

cmd_done() {
  local c stamp dest i=2 copied=""
  c=$(count)
  [[ $c -gt 0 ]] || { echo "No snags"; return 0; }
  render >"$cur/issues.md"
  stamp=$(date +%Y-%m-%d-%H%M)
  dest=$dir/$stamp
  while [[ -e $dest ]]; do dest=$dir/$stamp-$((i++)); done
  mv "$cur" "$dest"
  ln -sfn "$dest" "$dir/latest"
  printf %s "$dest" | pbcopy 2>/dev/null && copied=" (path copied)"
  echo "$c snag$([[ $c == 1 ]] || echo s) → ${dest/#$HOME/~}$copied"
}

cmd_latest() {
  [[ -L $dir/latest ]] || { echo "No finished snags in ${dir/#$HOME/~}" >&2; return 1; }
  readlink "$dir/latest"
}

ok() { echo "✓ $*"; }
bad() { echo "✗ $*"; failed=1; }

# Puts `snag` on PATH: the first writable PATH dir among the usual ones, never over a foreign file.
link_cli() {
  local d
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    [[ :$user_path: == *:$d:* && -w $d ]] || continue
    [[ ! -e $d/snag || -L $d/snag ]] || continue
    ln -sfn "$root/bin/snag" "$d/snag"
    echo "$d/snag"
    return 0
  done
  return 1
}

# Idempotent: checks every requirement, builds the helpers and links the CLI. Safe to rerun as a doctor.
cmd_setup() {
  local failed=0 link scripts=$root/raycast
  ok "macOS $(sw_vers -productVersion)"
  if command -v swiftc >/dev/null; then
    ok "swiftc"
    if build note && build hud; then ok "Built the note window and the counter"; else bad "Build failed (see above)"; fi
  else
    bad "swiftc missing. Run: xcode-select --install"
  fi
  if command -v jq >/dev/null; then ok "jq"; else bad "jq missing (macOS 15+ ships it). Run: brew install jq"; fi
  if link=$(link_cli); then
    ok "snag command → ${link/#$HOME/~}"
  else
    echo "· snag command not linked. Add $root/bin to PATH to use it in a terminal"
  fi
  if [[ -d /Applications/Raycast.app || -d $HOME/Applications/Raycast.app ]]; then
    ok "Raycast"
  else
    bad "Raycast missing. Install it from https://raycast.com"
  fi
  echo "· Snags go to ${dir/#$HOME/~} (change with dir=<path> in ${config/#$HOME/~})"
  [[ $failed == 0 ]] || { echo; echo "Fix the ✗ lines, then run snag setup again."; return 1; }

  printf %s "$scripts" | pbcopy 2>/dev/null || true
  cat <<EOF

Last step, in Raycast (the folder path is on your clipboard):
1. Settings (⌘,) → Extensions → + → Add Script Directory.
2. Press ⌘⇧G, paste, and choose: ${scripts/#$HOME/~}
3. Search "Snag" in the Extensions list and record a hotkey, for example ⌃⌥S.
4. Press the hotkey once and allow Screen Recording for Raycast. Restart Raycast after that.
EOF
}

cmd_update() {
  git -C "$root" pull --ff-only --quiet
  build note && build hud
  echo "snag is at $(git -C "$root" log -1 --format='%h %s')"
}

usage() {
  cat <<'EOF'
usage: snag <command>

  add      screenshot a region and add a note to the open stack
  undo     remove the last snag
  ls       list the open stack
  done     write issues.md, copy the folder path
  latest   print the path of the last finished stack
  setup    check requirements, build, link the CLI (rerun any time)
  update   pull the latest version and rebuild
EOF
}

case ${1:-} in
  add) cmd_add ;;
  undo) cmd_undo ;;
  ls) cmd_ls ;;
  done) cmd_done ;;
  latest) cmd_latest ;;
  setup) cmd_setup ;;
  update) cmd_update ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
